<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-table-product-image" author="Roman">
        <createTable tableName="image">
            <column name="image_uuid" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_uuid" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_product" referencedTableName="product"
                             referencedColumnNames="uuid" deleteCascade="false"/>
            </column>
            <column name="image_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="image"
                             columnNames="product_uuid, image_name"
                             constraintName="unique_product_image"/>
    </changeSet>
</databaseChangeLog>
