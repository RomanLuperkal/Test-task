<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-table-product" author="Roman">
        <createTable tableName="product">
            <column name="uuid" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="article_number" type="VARCHAR">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_article_number"/>
            </column>
            <column name="description" type="VARCHAR"/>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_category"
                             referencedTableName="categories" referencedColumnNames="category_id"
                             deleteCascade="false"/>
            </column>
            <column name="price" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="last_update" type="TIMESTAMP(0)"/>
            <column name="creation_date" type="TIMESTAMP(0)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
